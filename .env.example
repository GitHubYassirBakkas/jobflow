# Safe example values only. Spring Boot does not automatically load this file.
# For local Windows CMD usage, set these variables in the terminal before starting the backend.

DB_URL=jdbc:postgresql://localhost:5432/jobflow_db
DB_USERNAME=postgres
DB_PASSWORD=replace-with-your-local-database-password

JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters
JWT_EXPIRATION_SECONDS=3600

# Frontend only. Vite exposes VITE_* values to browser code, so never put secrets here.
VITE_API_BASE_URL=http://localhost:8080
